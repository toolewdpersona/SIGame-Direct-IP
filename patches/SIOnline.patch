diff --git a/tauri/src-tauri/src/direct_host.rs b/tauri/src-tauri/src/direct_host.rs
new file mode 100644
index 0000000000000000000000000000000000000000..801e1ee6f46cb9b7e39dcbc8ceb235c1985c918e
--- /dev/null
+++ b/tauri/src-tauri/src/direct_host.rs
@@ -0,0 +1,176 @@
+//! Owns the local game server for exactly the lifetime of this application.
+use serde::Serialize;
+use std::{
+    fs::OpenOptions,
+    io::{Read, Write},
+    net::{SocketAddr, TcpStream},
+    process::{Child, Command, Stdio},
+    sync::{Arc, Mutex},
+    time::{Duration, Instant, SystemTime, UNIX_EPOCH},
+};
+use tauri::Manager;
+
+#[derive(Default)]
+pub struct DirectHostState(pub Arc<Mutex<Option<RunningHost>>>);
+
+pub struct RunningHost {
+    child: Child,
+    info: HostInfo,
+    token: String,
+}
+
+impl Drop for RunningHost {
+    fn drop(&mut self) {
+        let address = SocketAddr::from(([127, 0, 0, 1], self.info.port));
+        if let Ok(mut stream) = TcpStream::connect_timeout(&address, Duration::from_millis(200)) {
+            let _ = stream.set_write_timeout(Some(Duration::from_millis(300)));
+            let _ = stream.set_read_timeout(Some(Duration::from_millis(300)));
+            let _ = write!(stream, "POST /direct/stop HTTP/1.0\r\nHost: 127.0.0.1:{}\r\nX-Instance-Token: {}\r\nContent-Length: 0\r\n\r\n", self.info.port, self.token);
+            let mut response = [0u8; 1024];
+            let _ = stream.read(&mut response);
+        }
+        let deadline = Instant::now() + Duration::from_secs(3);
+        while Instant::now() < deadline {
+            if matches!(self.child.try_wait(), Ok(Some(_))) { return; }
+            std::thread::sleep(Duration::from_millis(50));
+        }
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+#[derive(Clone, Serialize)]
+pub struct HostInfo {
+    uri: String,
+    port: u16,
+    addresses: Vec<String>,
+}
+
+fn host_addresses(port: u16, token: &str) -> Option<Vec<String>> {
+    let address = SocketAddr::from(([127, 0, 0, 1], port));
+    let Ok(mut stream) = TcpStream::connect_timeout(&address, Duration::from_millis(200)) else {
+        return None;
+    };
+    let _ = stream.set_read_timeout(Some(Duration::from_millis(300)));
+    let _ = stream.set_write_timeout(Some(Duration::from_millis(300)));
+    if write!(stream, "GET /direct/health HTTP/1.0\r\nHost: 127.0.0.1:{port}\r\nConnection: close\r\n\r\n").is_err() {
+        return None;
+    }
+    let mut response = String::new();
+    // Windows can report a reset after the peer has sent a complete response.
+    // Only a complete, valid JSON document with our instance identity is accepted.
+    let _ = stream.take(8192).read_to_string(&mut response);
+    let Some((headers, body)) = response.split_once("\r\n\r\n") else { return None; };
+    if !headers.starts_with("HTTP/1.1 200") && !headers.starts_with("HTTP/1.0 200") {
+        return None;
+    }
+    let value = serde_json::from_str::<serde_json::Value>(body).ok()?;
+    if value["mode"] != "sigame-direct" || value["instanceToken"] != token { return None; }
+    Some(value["addresses"].as_array().map(|items| items.iter()
+        .filter_map(|item| item.as_str().map(String::from)).collect()).unwrap_or_default())
+}
+
+/// Starts the bundled server without a shell or a visible helper window.
+#[tauri::command]
+pub async fn start_direct_host(
+    app: tauri::AppHandle,
+    state: tauri::State<'_, DirectHostState>,
+    port: u16,
+) -> Result<HostInfo, String> {
+    if port == 0 {
+        return Err("Укажите порт от 1 до 65535".into());
+    }
+    let state = state.0.clone();
+    tauri::async_runtime::spawn_blocking(move || {
+        let mut guard = state.lock().map_err(|_| "Не удалось получить состояние хоста")?;
+        if let Some(host) = guard.as_mut() {
+            if host.child.try_wait().map_err(|e| e.to_string())?.is_none() {
+                return if host.info.port == port {
+                    Ok(host.info.clone())
+                } else {
+                    Err(format!("Хост уже запущен на порту {}. Сначала остановите его.", host.info.port))
+                };
+            }
+        }
+        *guard = None;
+        let executable = std::env::current_exe().map_err(|e| e.to_string())?;
+        let directory = executable.parent().ok_or("Не найдена папка игры")?;
+        let server = directory.join("DirectHost").join("SIGame.DirectHost.exe");
+        if !server.is_file() {
+            return Err("Не найден DirectHost/SIGame.DirectHost.exe. Скопируйте папку DirectHost вместе с игрой.".into());
+        }
+        let data = app.path().app_local_data_dir().map_err(|e| e.to_string())?.join("DirectHost");
+        std::fs::create_dir_all(&data).map_err(|e| e.to_string())?;
+        let log_path = data.join("host.log");
+        let log = OpenOptions::new().create(true).append(true).open(&log_path).map_err(|e| e.to_string())?;
+        let error_log = log.try_clone().map_err(|e| e.to_string())?;
+        let token = format!("{}-{}", std::process::id(), SystemTime::now().duration_since(UNIX_EPOCH).unwrap_or_default().as_nanos());
+        let mut command = Command::new(server);
+        command.args(["--port", &port.to_string(), "--parent-pid", &std::process::id().to_string(), "--instance-token", &token])
+            .current_dir(&data)
+            .stdin(Stdio::null()).stdout(Stdio::from(log)).stderr(Stdio::from(error_log));
+        #[cfg(windows)]
+        {
+            use std::os::windows::process::CommandExt;
+            command.creation_flags(0x08000000); // CREATE_NO_WINDOW
+        }
+        let child = command.spawn().map_err(|e| format!("Не удалось запустить хост: {e}"))?;
+        let info = HostInfo { uri: format!("http://127.0.0.1:{port}"), port, addresses: Vec::new() };
+        let mut host = RunningHost { child, info: info.clone(), token: token.clone() };
+        let deadline = Instant::now() + Duration::from_secs(30);
+        loop {
+            if let Some(status) = host.child.try_wait().map_err(|e| e.to_string())? {
+                return Err(format!("Хост завершился ({status}). Возможно, порт занят. Журнал: {}", log_path.display()));
+            }
+            if let Some(addresses) = host_addresses(port, &token) {
+                host.info.addresses = addresses;
+                let info = host.info.clone();
+                *guard = Some(host);
+                return Ok(info);
+            }
+            if Instant::now() >= deadline {
+                return Err(format!("Хост не запустился за 30 секунд. Журнал: {}", log_path.display()));
+            }
+            std::thread::sleep(Duration::from_millis(100));
+        }
+    }).await.map_err(|e| e.to_string())?
+}
+
+#[tauri::command]
+pub fn stop_direct_host(state: tauri::State<'_, DirectHostState>) -> Result<(), String> {
+    state.0.lock().map_err(|_| "Не удалось получить состояние хоста")?.take();
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::net::TcpListener;
+
+    fn respond(status: &str, body: &str) -> u16 {
+        let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+        let port = listener.local_addr().unwrap().port();
+        let response = format!("HTTP/1.0 {status}\r\nContent-Length: {}\r\n\r\n{body}", body.len());
+        std::thread::spawn(move || {
+            let (mut stream, _) = listener.accept().unwrap();
+            let mut request = [0u8; 1024];
+            let _ = stream.read(&mut request);
+            stream.write_all(response.as_bytes()).unwrap();
+        });
+        port
+    }
+
+    #[test]
+    fn readiness_requires_our_server_instance() {
+        let body = r#"{"mode":"sigame-direct","instanceToken":"owned"}"#;
+        assert!(host_addresses(respond("200 OK", body), "owned").is_some());
+        assert!(host_addresses(respond("200 OK", body), "different").is_none());
+        assert!(host_addresses(respond("503 Unavailable", body), "owned").is_none());
+        assert!(host_addresses(respond("200 OK", r#"{"mode":"other","instanceToken":"owned"}"#), "owned").is_none());
+    }
+
+    #[test]
+    fn readiness_rejects_unrelated_http_service() {
+        assert!(host_addresses(respond("200 OK", "<html>another service</html>"), "owned").is_none());
+    }
+}
