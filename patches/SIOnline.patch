@@ -0,0 +1,68 @@
+describe('leaving a direct session', () => {
+	const originalWindow = globalThis.window;
+	const originalStorage = globalThis.sessionStorage;
+	let invoke: jest.Mock;
+	let reload: jest.Mock;
+	let storage: Map<string, string>;
+	let leaveDirectSession: typeof import('../src/utils/DirectLauncher').leaveDirectSession;
+	let connection: typeof import('../src/utils/DirectConnection');
+
+	beforeEach(() => {
+		jest.resetModules();
+		invoke = jest.fn().mockResolvedValue(undefined);
+		reload = jest.fn();
+		storage = new Map([['SIGame.DirectIP.launch', 'stale launch']]);
+		Object.defineProperty(globalThis, 'sessionStorage', {
+			configurable: true, value: { removeItem: (key: string) => storage.delete(key) },
+		});
+		Object.defineProperty(globalThis, 'window', {
+			configurable: true,
+			value: {
+				__TAURI__: { core: { invoke } },
+				location: { pathname: '/', reload },
+				history: { replaceState: jest.fn() },
+				confirm: jest.fn(() => { throw new Error('Exit must not ask for confirmation'); }),
+			},
+		});
+		({ leaveDirectSession } = require('../src/utils/DirectLauncher'));
+		connection = require('../src/utils/DirectConnection');
+		connection.setDirectSession({ uri: 'http://127.0.0.1:51234', isHost: true, addresses: [] });
+	});
+
+	afterEach(() => {
+		Object.defineProperty(globalThis, 'window', { value: originalWindow, configurable: true });
+		Object.defineProperty(globalThis, 'sessionStorage', { value: originalStorage, configurable: true });
+	});
+
+	test('waits for shutdown and coalesces repeated exit clicks without confirmation', async () => {
+		let stopped!: () => void;
+		invoke.mockReturnValue(new Promise<void>(resolve => { stopped = resolve; }));
+		const first = leaveDirectSession();
+		expect(leaveDirectSession()).toBe(first);
+		expect(invoke).toHaveBeenCalledTimes(1);
+		expect(invoke).toHaveBeenCalledWith('stop_direct_host', {});
+		expect(reload).not.toHaveBeenCalled();
+		stopped();
+		await first;
+		expect(reload).toHaveBeenCalledTimes(1);
+		expect(storage.has('SIGame.DirectIP.launch')).toBe(false);
+		expect(connection.getDirectSession()).toBeNull();
+	});
+
+	test('a guest exits without stopping somebody else\'s host', async () => {
+		connection.setDirectSession({ uri: 'http://192.0.2.1:51234', isHost: false, addresses: [] });
+		await leaveDirectSession();
+		expect(invoke).not.toHaveBeenCalled();
+		expect(reload).toHaveBeenCalledTimes(1);
+	});
+
+	test('a failed shutdown keeps the session and permits a retry', async () => {
+		invoke.mockRejectedValueOnce(new Error('native shutdown failed'));
+		await expect(leaveDirectSession()).rejects.toThrow('native shutdown failed');
+		expect(connection.getDirectSession()?.isHost).toBe(true);
+		expect(reload).not.toHaveBeenCalled();
+		await leaveDirectSession();
+		expect(invoke).toHaveBeenCalledTimes(2);
+		expect(reload).toHaveBeenCalledTimes(1);
+	});
+});
