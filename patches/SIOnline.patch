+import { AppDispatch } from '../state/store';
+import { avatarLoadEnd, avatarLoadError, avatarLoadStart, userErrorChanged } from '../state/commonSlice';
+import { changeAvatar } from '../state/userSlice';
+import { setAvatarKey } from '../state/settingsSlice';
+import getErrorMessage from '../utils/ErrorHelpers';
+import { readDirectAvatar, uploadDirectAvatar } from '../utils/DirectAvatar';
+
+export async function uploadSavedDirectAvatar(dispatch: AppDispatch, serverUri: string): Promise<void> {
+	dispatch(avatarLoadStart());
+	try {
+		const file = await readDirectAvatar();
+		const uri = file ? await uploadDirectAvatar(serverUri, file.name, file) : '';
+		dispatch(changeAvatar(uri));
+		dispatch(setAvatarKey(uri));
+		dispatch(avatarLoadEnd());
+	} catch (error) {
+		const message = getErrorMessage(error);
+		dispatch(avatarLoadError(message));
+		dispatch(userErrorChanged('Не удалось передать аватарку хосту: ' + message));
+	}
+}
