+import { createDirectUri, directConfig, parseDirectPort, restrictDirectFetch } from '../src/utils/DirectConnection';
+
+describe('direct host endpoints', () => {
+	test.each([
+		['192.168.1.20', '7777', 'http://192.168.1.20:7777'],
+		['127.0.0.1', '80', 'http://127.0.0.1'],
+		[' my-host.local ', '1234', 'http://my-host.local:1234'],
+		['[::1]', '7777', 'http://[::1]:7777'],
+	])('accepts %s and port %s', (host, port, expected) => {
+		expect(createDirectUri(host, port)).toBe(expected);
+	});
+
+	test.each(['', '0', '-1', '65536', '1e3', '7777/anything', '1.2'])('rejects invalid port %s', port => {
+		expect(() => parseDirectPort(port)).toThrow();
+	});
+
+	test.each([
+		'http://example.com', 'user@host', 'host/path', 'host#fragment', 'host?query', 'a\\b', '127.0.0.1:7777', '999.999.999.999'
+	])('rejects non-host input %s', host => {
+		expect(() => createDirectUri(host, '7777')).toThrow();
+	});
+
+	test('removes public service configuration while preserving the original online config', () => {
+		const online = {
+			serverDiscoveryUri: 'https://official/discovery',
+			siStatisticsServiceUri: 'https://official/stats',
+			appRegistryServiceUri: 'https://official/registry',
+			registerServiceWorker: true,
+		};
+		const direct = directConfig(online, 'http://192.168.1.20:7777');
+		expect(direct.serverUri).toBe('http://192.168.1.20:7777');
+		expect(direct.serverDiscoveryUri).toBeUndefined();
+		expect(direct.siStatisticsServiceUri).toBe('');
+		expect(direct.appRegistryServiceUri).toBe('');
+		expect(direct.registerServiceWorker).toBe(false);
+		expect(online.serverDiscoveryUri).toBe('https://official/discovery');
+	});
+});
+
+describe('direct network boundary', () => {
+	const originalFetch = globalThis.fetch;
+	const originalWindow = globalThis.window;
+	let network: jest.Mock;
+	beforeEach(() => {
+		network = jest.fn().mockResolvedValue({ ok: true });
+		globalThis.fetch = network;
+		Object.defineProperty(globalThis, 'window', {
+			value: { location: { href: 'http://tauri.localhost/', origin: 'http://tauri.localhost' } },
+			configurable: true,
+		});
+		restrictDirectFetch('http://192.168.1.20:7777');
+	});
+	afterEach(() => {
+		globalThis.fetch = originalFetch;
+		Object.defineProperty(globalThis, 'window', { value: originalWindow, configurable: true });
+	});
+
+	test('allows the host and local app assets, refusing automatic redirects', async () => {
+		await fetch('http://192.168.1.20:7777/api/v1/info/host');
+		await fetch('/local-asset.png');
+		expect(network).toHaveBeenCalledTimes(2);
+		expect(network.mock.calls[0][1].redirect).toBe('error');
+	});
+
+	test('allows only the native Steam package-file endpoint in Tauri', async () => {
+		window.__TAURI__ = {};
+		await fetch('http://sigame.localhost/file?id=1234');
+		await fetch('http://ipc.localhost/get_workshop_file_url');
+		expect(network).toHaveBeenCalledTimes(2);
+		await expect(fetch('http://sigame.localhost/other')).rejects.toThrow('прямом режиме');
+	});
+
+	test('does not allow the Steam file origin outside the native app', async () => {
+		await expect(fetch('http://sigame.localhost/file?id=1234')).rejects.toThrow('прямом режиме');
+	});
+
+	test.each([
+		'https://vladimirkhil.com/api/si/servers',
+		'https://content.vladimirkhil.com/file',
+		'http://192.168.1.20:7778/another-service',
+		'http://192.168.1.20.attacker.test:7777/file',
+	])('blocks %s before the network is called', async url => {
+		await expect(fetch(url)).rejects.toThrow('прямом режиме');
+		expect(network).not.toHaveBeenCalled();
+	});
+});
