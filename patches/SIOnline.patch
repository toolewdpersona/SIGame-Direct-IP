+import { directLibrarySelection, directLibraryStorages, importDirectLibraryPackage } from '../src/utils/DirectLibraries';
+import PackageType from '../src/model/enums/PackageType';
+import { PackageData } from '../src/state/gameSlice';
+
+const pack = (uri: string | null, type = PackageType.SIStorage): PackageData => ({ type, uri, data: null, name: '', id: null });
+
+test('both catalogues use the selected host and keep their original filter capabilities', () => {
+	const storages = directLibraryStorages('http://127.0.0.1:51234', true);
+	expect(storages.map(s => s.serviceUri)).toEqual([
+		'http://127.0.0.1:51234/direct/libraries/default', 'http://127.0.0.1:51234/direct/libraries/sibrowser',
+	]);
+	expect(storages[0].identifiersSupported).toBe(true);
+	expect(storages[1].identifiersSupported).toBe(false);
+});
+
+test('selection contains only a catalogue identifier or the random language', () => {
+	expect(directLibrarySelection(pack('direct-library:sibrowser/26017'), 'ru-RU')).toEqual({ library: 'sibrowser', id: '26017' });
+	expect(directLibrarySelection(pack(null, PackageType.Random), 'en-US')).toEqual({ library: 'random', language: 'en-US' });
+});
+
+test.each(['https://127.0.0.1/private', 'direct-library:evil/1', 'direct-library:default/../../private'])('rejects arbitrary downloads %s', uri => {
+	expect(() => directLibrarySelection(pack(uri), 'ru-RU')).toThrow();
+});
+
+test('imports to the local host and preserves a useful storage failure message', async () => {
+	const originalFetch = globalThis.fetch;
+	const fetchMock = jest.fn().mockResolvedValue({ ok: true, json: async () => ({ type: 1, uri: 'direct:123' }) });
+	globalThis.fetch = fetchMock;
+	try {
+		expect(await importDirectLibraryPackage('http://127.0.0.1:51234', pack('direct-library:sibrowser/26017'), 'ru-RU'))
+			.toEqual({ type: 1, uri: 'direct:123' });
+		expect(fetchMock.mock.calls[0][0]).toBe('http://127.0.0.1:51234/direct/library-package');
+		expect(JSON.parse(fetchMock.mock.calls[0][1].body)).toEqual({ library: 'sibrowser', id: '26017' });
+		fetchMock.mockResolvedValue({ ok: false, json: async () => ({ detail: 'Пакет удалён из библиотеки.' }) });
+		await expect(importDirectLibraryPackage('http://127.0.0.1:51234', pack(null, PackageType.Random), 'ru-RU'))
+			.rejects.toThrow('Пакет удалён из библиотеки.');
+	} finally { globalThis.fetch = originalFetch; }
+});
