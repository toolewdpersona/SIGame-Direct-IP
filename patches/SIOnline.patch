new file mode 100644
index 0000000000000000000000000000000000000000..26fe7fbb8bef9544450414a9fbec9dc500534e7c
--- /dev/null
+++ b/src/utils/DirectAvatar.ts
@@ -0,0 +1,61 @@
+import Constants from '../model/enums/Constants';
+import { getDirectSession } from './DirectConnection';
+
+export function isDirectVideoAvatar(uri: string): boolean {
+	return !!getDirectSession() && /\/direct\/avatars\/[a-f0-9]{64}\.(mp4|webm)$/.test(uri);
+}
+
+async function openAvatarDatabase(): Promise<IDBDatabase> {
+	return new Promise((resolve, reject) => {
+		const request = indexedDB.open('SIGame.DirectIP', 1);
+		request.onupgradeneeded = () => request.result.createObjectStore('avatars');
+		request.onsuccess = () => resolve(request.result);
+		request.onerror = () => reject(request.error);
+	});
+}
+
+/** Blob storage avoids localStorage's small string quota and base64 copies. */
+export async function saveDirectAvatar(file: File | null): Promise<void> {
+	const database = await openAvatarDatabase();
+	try {
+		await new Promise<void>((resolve, reject) => {
+			const transaction = database.transaction('avatars', 'readwrite');
+			const store = transaction.objectStore('avatars');
+			if (file) { store.put(file, 'selected'); } else { store.delete('selected'); }
+			transaction.oncomplete = () => resolve();
+			transaction.onabort = () => reject(transaction.error);
+			transaction.onerror = () => reject(transaction.error);
+		});
+	} finally { database.close(); }
+}
+
+export async function readDirectAvatar(): Promise<File | null> {
+	const database = await openAvatarDatabase();
+	try {
+		const file = await new Promise<File | undefined>((resolve, reject) => {
+			const request = database.transaction('avatars').objectStore('avatars').get('selected');
+			request.onsuccess = () => resolve(request.result);
+			request.onerror = () => reject(request.error);
+		});
+		if (file) { return file; }
+	} finally { database.close(); }
+	const base64 = localStorage.getItem(Constants.AVATAR_KEY);
+	const name = localStorage.getItem(Constants.AVATAR_NAME_KEY);
+	if (!base64 || !name) { return null; }
+	return new File([Uint8Array.from(window.atob(base64), char => char.charCodeAt(0))], name);
+}
+
+/** Upload a selected avatar only to the current direct host. */
+export async function uploadDirectAvatar(serverUri: string, fileName: string, data: Blob): Promise<string> {
+	const form = new FormData();
+	form.append('file', data, fileName);
+	const response = await fetch(`${serverUri}/direct/avatars`, { method: 'POST', body: form });
+	const result = await response.json();
+	if (!response.ok) {
+		throw new Error(result.error || 'Не удалось загрузить аватарку на хост.');
+	}
+	if (typeof result.uri !== 'string' || !/^\/direct\/avatars\/[a-f0-9]{64}\.(png|jpg|gif|mp4|webm)$/.test(result.uri)) {
+		throw new Error('Хост вернул некорректный адрес аватарки.');
+	}
+	return new URL(result.uri, serverUri).href;
+}
diff --git a/src/utils/DirectAvatarPreview.ts b/src/utils/DirectAvatarPreview.ts
new file mode 100644
index 0000000000000000000000000000000000000000..06283a7f3ab2cc4cad795490c717284aba7151dd
--- /dev/null
+++ b/src/utils/DirectAvatarPreview.ts
@@ -0,0 +1,61 @@
+import { readDirectAvatar } from './DirectAvatar';
+
+const SIZE = 96;
+let cached: { key: string | null; preview: Promise<string | null> } | null = null;
+
+function drawFrame(source: CanvasImageSource, width: number, height: number): string {
+	if (!width || !height) { throw new Error('Empty avatar frame'); }
+	const canvas = document.createElement('canvas');
+	canvas.width = SIZE;
+	canvas.height = SIZE;
+	const context = canvas.getContext('2d');
+	if (!context) { throw new Error('Canvas unavailable'); }
+	const scale = Math.min(SIZE / width, SIZE / height);
+	const scaledWidth = width * scale;
+	const scaledHeight = height * scale;
+	context.drawImage(source, (SIZE - scaledWidth) / 2, (SIZE - scaledHeight) / 2, scaledWidth, scaledHeight);
+	return canvas.toDataURL('image/png');
+}
+
+async function createPreview(): Promise<string | null> {
+	const file = await readDirectAvatar();
+	if (!file) { return null; }
+	if (!/\.(mp4|webm)$/i.test(file.name)) {
+		// ImageBitmap decodes the first frame of an animated image without keeping its animation alive.
+		const bitmap = await createImageBitmap(file);
+		try { return drawFrame(bitmap, bitmap.width, bitmap.height); } finally { bitmap.close(); }
+	}
+
+	const uri = URL.createObjectURL(file);
+	const video = document.createElement('video');
+	video.preload = 'auto';
+	video.muted = true;
+	video.playsInline = true;
+	let timeout: ReturnType<typeof setTimeout> | undefined;
+	try {
+		return await new Promise<string>((resolve, reject) => {
+			video.onloadeddata = () => {
+				try { resolve(drawFrame(video, video.videoWidth, video.videoHeight)); } catch (error) { reject(error); }
+			};
+			video.onerror = () => reject(new Error('Cannot decode avatar preview'));
+			timeout = setTimeout(() => reject(new Error('Avatar preview timed out')), 8000);
+			video.src = uri;
+		});
+	} finally {
+		clearTimeout(timeout);
+		video.onloadeddata = null;
+		video.onerror = null;
+		video.pause();
+		video.removeAttribute('src');
+		video.load();
+		URL.revokeObjectURL(uri);
+	}
+}
+
+/** Cache one tiny still per selected avatar; menu/room rerenders must not keep a second video decoder running. */
+export function getDirectAvatarPreview(key: string | null): Promise<string | null> {
+	if (!cached || cached.key !== key) {
+		cached = { key, preview: createPreview().catch(() => null) };
+	}
+	return cached.preview;
+}
diff --git a/src/utils/DirectConnection.ts b/src/utils/DirectConnection.ts
new file mode 100644
index 0000000000000000000000000000000000000000..6f47e106ebf7bb75f01903c4a81df120d7fdf922
--- /dev/null
+++ b/src/utils/DirectConnection.ts
@@ -0,0 +1,85 @@
+import Config from '../Config';
+
+/** Endpoint selected explicitly before the game starts any network activity. */
+export interface DirectSession {
+	uri: string;
+	isHost: boolean;
+	addresses: string[];
+}
+
+let session: DirectSession | null = null;
+
+export function getDirectSession(): DirectSession | null {
+	return session;
+}
+
+export function setDirectSession(value: DirectSession | null): void {
+	session = value;
+}
+
+export function parseDirectPort(value: string): number {
+	if (!/^\d{1,5}$/.test(value.trim())) {
+		throw new Error('Введите порт от 1 до 65535.');
+	}
+
+	const port = Number(value);
+	if (port < 1 || port > 65535) {
+		throw new Error('Введите порт от 1 до 65535.');
+	}
+
+	return port;
+}
+
+/** Accepts only an IP address or DNS hostname, never credentials, paths or a URL. */
+export function createDirectUri(host: string, portValue: string): string {
+	const port = parseDirectPort(portValue);
+	const value = host.trim();
+	const ipv6 = value.startsWith('[') && value.endsWith(']');
+	if (!value || /[\s/@?#\\]/.test(value) || (!ipv6 && value.includes(':'))) {
+		throw new Error('Введите IP-адрес или имя хоста без http:// и номера порта.');
+	}
+	if (!ipv6 && !/^[a-zA-Z0-9.-]+$/.test(value)) {
+		throw new Error('Некорректный адрес хоста.');
+	}
+
+	try {
+		const uri = new URL(`http://${value}:${port}`);
+		if (!uri.hostname || uri.username || uri.password || uri.pathname !== '/') {
+			throw new Error('Некорректный адрес хоста.');
+		}
+		return uri.origin;
+	} catch {
+		throw new Error('Некорректный адрес хоста.');
+	}
+}
+
+export function directConfig(config: Config, uri: string): Config {
+	return {
+		...config,
+		directMode: true,
+		serverUri: uri,
+		serverDiscoveryUri: undefined,
+		siStatisticsServiceUri: '',
+		appRegistryServiceUri: '',
+		registerServiceWorker: false,
+		askForConsent: false,
+		rewriteUrl: false,
+		ads: '',
+	};
+}
+
+/** Keep optional client integrations from contacting any service outside the selected host. */
+export function restrictDirectFetch(uri: string): void {
+	const fetch = globalThis.fetch.bind(globalThis);
+	const allowedOrigin = new URL(uri).origin;
+	globalThis.fetch = (input: RequestInfo | URL, init?: RequestInit): Promise<Response> => {
+		const raw = input instanceof Request ? input.url : String(input);
+		const url = new URL(raw, window.location.href);
+		const nativeEndpoint = !!window.__TAURI__ && (url.origin === 'http://ipc.localhost' ||
+			(url.origin === 'http://sigame.localhost' && url.pathname === '/file'));
+		if (url.protocol.startsWith('http') && url.origin !== allowedOrigin && url.origin !== window.location.origin && !nativeEndpoint) {
+			return Promise.reject(new Error('В прямом режиме доступны только файлы и сервер выбранного хоста.'));
+		}
+		return fetch(input, { ...init, redirect: 'error' });
+	};
+}
diff --git a/src/utils/DirectLauncher.ts b/src/utils/DirectLauncher.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8f46ea62c10e845ede945bfd7e8c8ac0e9674c86
--- /dev/null
+++ b/src/utils/DirectLauncher.ts
@@ -0,0 +1,44 @@
+import * as React from 'react';
+import { INavigationState } from '../state/uiSlice';
+import { DirectSession, getDirectSession, setDirectSession } from './DirectConnection';
+
+const launchKey = 'SIGame.DirectIP.launch';
+let leavingSession: Promise<void> | null = null;
+
+type Launch = { session: DirectSession } | { navigation: INavigationState };
+
+export const DirectLauncherContext = React.createContext({ enabled: false, menuOnly: false });
+
+/** Reload once to initialize the chosen host and network clients from a clean state. */
+export function launchGame(launch: Launch): void {
+	sessionStorage.setItem(launchKey, JSON.stringify(launch));
+	window.history.replaceState(null, '', window.location.href);
+	window.location.reload();
+}
+
+export function takeLaunch(): Launch | null {
+	const saved = sessionStorage.getItem(launchKey);
+	sessionStorage.removeItem(launchKey);
+	if (!saved) { return null; }
+	try { return JSON.parse(saved) as Launch; } catch { return null; }
+}
+
+/** Stop our own server before reloading the normal menu; repeated clicks share the same exit. */
+export function leaveDirectSession(): Promise<void> {
+	if (leavingSession) { return leavingSession; }
+	leavingSession = (async () => {
+		if (getDirectSession()?.isHost) {
+			const core = window.__TAURI__?.core;
+			if (!core) { throw new Error('Не удалось связаться с локальным хостом.'); }
+			await core.invoke('stop_direct_host', {});
+		}
+		setDirectSession(null);
+		sessionStorage.removeItem(launchKey);
+		window.history.replaceState(null, '', window.location.pathname);
+		window.location.reload();
+	})().catch(error => {
+		leavingSession = null;
+		throw error;
+	});
+	return leavingSession;
+}
diff --git a/src/utils/DirectLibraries.ts b/src/utils/DirectLibraries.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e22694a5e3a6a2ba31d3861cc517a3225319bac7
--- /dev/null
+++ b/src/utils/DirectLibraries.ts
@@ -0,0 +1,40 @@
+import SIStorageInfo from '../client/contracts/SIStorageInfo';
+import PackageInfo from '../client/contracts/PackageInfo';
+import { PackageData } from '../state/gameSlice';
+import PackageType from '../model/enums/PackageType';
+
+/** Catalogue requests go through the local host; the normal direct network boundary stays closed. */
+export function directLibraryStorages(serverUri: string, russian: boolean): SIStorageInfo[] {
+	return [{
+		id: 'default', serviceUri: `${serverUri}/direct/libraries/default`,
+		name: russian ? 'Библиотека вопросов' : 'Question library',
+		randomPackagesSupported: true, identifiersSupported: true, maximumPageSize: 20,
+		uri: 'https://vladimirkhil.com/sistorage', packageProperties: ['logo'],
+		facets: ['languages', 'authors', 'tags', 'publishers', 'restrictions'],
+	}, {
+		id: 'sibrowser', serviceUri: `${serverUri}/direct/libraries/sibrowser`,
+		name: russian ? 'Библиотека вопросов SI BROWSER' : 'SI BROWSER question library',
+		randomPackagesSupported: false, identifiersSupported: false, maximumPageSize: 10,
+		uri: 'https://www.sibrowser.ru', packageProperties: ['logoUri'], facets: ['tags', 'tags2'],
+	}];
+}
+
+/** Send a catalogue identifier, never an arbitrary download URL, to the host. */
+export function directLibrarySelection(pack: PackageData, language: string): { library: string; id?: string; language?: string } {
+	if (pack.type === PackageType.Random) return { library: 'random', language };
+	const match = /^direct-library:(default|sibrowser)\/([a-zA-Z0-9-]+)$/.exec(pack.uri ?? '');
+	if (!match) throw new Error('Выберите пакет из библиотеки ещё раз.');
+	return { library: match[1], id: match[2] };
+}
+
+export async function importDirectLibraryPackage(serverUri: string, pack: PackageData, language: string): Promise<PackageInfo> {
+	const response = await fetch(`${serverUri}/direct/library-package`, {
+		method: 'POST', headers: { 'Content-Type': 'application/json' },
+		body: JSON.stringify(directLibrarySelection(pack, language)),
+	});
+	if (!response.ok) {
+		const error = await response.json();
+		throw new Error(error.detail ?? error.error ?? 'Не удалось загрузить пакет из библиотеки.');
+	}
+	return await response.json() as PackageInfo;
+}
