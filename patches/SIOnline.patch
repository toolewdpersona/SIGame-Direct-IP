+import reducer, { receiveLanguages, searchPackages, searchPackagesByValueFilters, setStorageIndex } from '../src/state/siPackagesSlice';
+
+test('switching libraries drops old cards and late responses cannot select a package from the wrong catalogue', () => {
+	let state = reducer(undefined, { type: 'init' });
+	state = reducer(state, searchPackages.pending('old', {}));
+	state = reducer(state, searchPackages.fulfilled({ total: 1, packages: [{ id: 'old-guid' }] }, 'old', {}));
+	state = reducer(state, searchPackages.pending('late', {}));
+	state = reducer(state, receiveLanguages.pending('old-language', undefined));
+	state = reducer(state, receiveLanguages.fulfilled({
+		languages: [{ id: 1, code: 'ru-RU', name: 'Russian' }], currentLanguage: 'ru-RU',
+	}, 'old-language', undefined));
+	state = reducer(state, receiveLanguages.pending('late-language', undefined));
+	state = reducer(state, setStorageIndex(1));
+	expect(state.packages.packages).toEqual([]);
+	expect(state.languageId).toBeUndefined();
+	state = reducer(state, searchPackagesByValueFilters.pending('new', {}));
+	state = reducer(state, searchPackages.fulfilled({ total: 1, packages: [{ id: 'late-guid' }] }, 'late', {}));
+	state = reducer(state, receiveLanguages.fulfilled({
