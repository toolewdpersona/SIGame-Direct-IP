diff --git a/src/components/DirectConnection/DirectConnection.tsx b/src/components/DirectConnection/DirectConnection.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..454278eadaacea62e2d884fa14d1ef5f83283d6e
--- /dev/null
+++ b/src/components/DirectConnection/DirectConnection.tsx
@@ -0,0 +1,81 @@
+import * as React from 'react';
+import { createDirectUri, DirectSession, parseDirectPort } from '../../utils/DirectConnection';
+import './DirectConnection.scss';
+
+/** Starts a selected connection mode only after the user has chosen an endpoint. */
+interface Props {
+	onSelect: (session: DirectSession) => void;
+	onClose: () => void;
+}
+
+export default function DirectConnection({ onSelect, onClose }: Props): JSX.Element {
+	const [host, setHost] = React.useState(localStorage.getItem('directHost') || '');
+	const [port, setPort] = React.useState(localStorage.getItem('directPort') || '51234');
+	const [error, setError] = React.useState('');
+	const [busy, setBusy] = React.useState(false);
+	const [mode, setMode] = React.useState<'host' | 'join' | null>(null);
+
+	const connect = async () => {
+		setBusy(true);
+		setError('');
+		try {
+			const parsedPort = parseDirectPort(port);
+			localStorage.setItem('directPort', String(parsedPort));
+			if (mode === 'host') {
+				if (!window.__TAURI__?.core) {
+					throw new Error('Создание хоста доступно в настольной версии игры.');
+				}
+				const result: { uri: string; addresses: string[] } = await window.__TAURI__.core.invoke('start_direct_host', { port: parsedPort });
+				onSelect({ uri: result.uri, isHost: true, addresses: result.addresses });
+			} else {
+				const uri = createDirectUri(host, port);
+				localStorage.setItem('directHost', host.trim());
+				onSelect({ uri, isHost: false, addresses: [] });
+			}
+		} catch (e) {
+			setError(e instanceof Error ? e.message : String(e));
+			setBusy(false);
+		}
+	};
+
+	if (mode === null) {
+		return <nav className='welcomeViewActions directMenu' aria-label='Игра по IP'>
+			<button type='button' className='standard welcomeRow left' onClick={() => setMode('host')}>Создать хост</button>
+			<button type='button' className='standard welcomeRow right' onClick={() => setMode('join')}>Подключиться по IP</button>
+			<button type='button' className='standard welcomeRow left' onClick={onClose}>Назад</button>
+		</nav>;
+	}
+
+	return <form className='directConnectionForm' aria-labelledby='directFormTitle' onSubmit={event => { event.preventDefault(); void connect(); }}>
+		<h2 id='directFormTitle'>{mode === 'host' ? 'Создать хост' : 'Подключиться по IP'}</h2>
+		<p className='directConnectionForm__description'>
+			{mode === 'host'
+				? 'После запуска выберите пакет из файла, библиотеки или мастерской Steam и создайте комнату.'
+				: 'Введите адрес и порт, которые сообщил хост.'}
+		</p>
+		<div className={`directConnectionForm__fields directConnectionForm__fields--${mode}`}>
+			{mode === 'join' && <label htmlFor='directHost'>IP-адрес хоста
+				<input id='directHost' value={host} onChange={event => setHost(event.target.value)} placeholder='192.168.1.10' disabled={busy} />
+			</label>}
+			<label htmlFor='directPort'>Порт
+				<input id='directPort' inputMode='numeric' value={port} onChange={event => setPort(event.target.value)} disabled={busy}
+					aria-describedby={mode === 'host' ? 'directPortHint' : undefined} />
+			</label>
+			{mode === 'host' && <p id='directPortHint' className='directConnectionForm__portHint'>
+				Передайте друзьям адрес этого компьютера и указанный порт.
+			</p>}
+		</div>
+		<p className='directConnectionForm__hint'>
+			Для игры через Интернет адрес и порт хоста должны быть доступны другим игрокам.
+		</p>
+		{error && <p role='alert' className='directConnectionForm__error'>{error}</p>}
+		<div className='directConnectionForm__actions'>
+			<button className='standard welcomeRow directConnectionForm__back' type='button' disabled={busy}
+				onClick={() => { setMode(null); setError(''); }}>Назад</button>
+			<button className='standard welcomeRow directConnectionForm__submit' type='submit' disabled={busy}>
+				{busy ? 'Подключение…' : mode === 'host' ? 'Запустить хост' : 'Подключиться'}
+			</button>
+		</div>
+	</form>;
+}
+
