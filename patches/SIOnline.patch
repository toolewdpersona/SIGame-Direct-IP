diff --git a/test/DirectPressClock.test.ts b/test/DirectPressClock.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4a5756ec92e1a676db00494ecb6d501a581635b3
--- /dev/null
+++ b/test/DirectPressClock.test.ts
@@ -0,0 +1,68 @@
+import DirectPressClock from '../src/utils/DirectPressClock';
+import roomReducer, { setDirectMetrics } from '../src/state/room2Slice';
+
+const signal = (text: string, attemptId?: number) => ({ IsSystem: true, Sender: '@', Text: text, DirectAttemptId: attemptId });
+
+test('measures only the first press from the current opening, without wall-clock or network delay', () => {
+	const clock = new DirectPressClock();
+	expect(clock.capture(100)).toBeNull();
+	clock.observe(signal('TRY\nNF', 3), 1000);
+	expect(clock.capture(1257.4)).toEqual({ DirectAttemptId: 3, DirectReactionMs: 257 });
+	expect(clock.capture(1500)).toBeNull();
+	clock.observe(signal('TRY', 4), 2000);
+	expect(clock.capture(2200)).toEqual({ DirectAttemptId: 4, DirectReactionMs: 200 });
+});
+
+test.each(['ENDTRY\n0', 'ENDTRY\nA', 'QUESTION_END', 'STAGE\nRound', 'PAUSE\n+'])('does not time presses after %s', text => {
+	const clock = new DirectPressClock();
+	clock.observe(signal('TRY', 3), 10);
+	clock.observe(signal(text), 100);
+	expect(clock.capture(150)).toBeNull();
+});
+
+test('reports an early press as negative only when answering opens', () => {
+	const clock = new DirectPressClock();
+	clock.observe(signal('CHOICE\n0\n0'), 100);
+	expect(clock.capture(400)).toEqual({ DirectEarlyPress: true });
+	expect(clock.capture(450)).toBeNull();
+	expect(clock.observe(signal('TRY', 7), 700)).toEqual({ DirectAttemptId: 7, DirectReactionMs: -300 });
+	expect(clock.capture(800)).toBeNull();
+	clock.observe(signal('CHOICE\n0\n1'), 1000);
+	clock.capture(1100);
+	clock.observe(signal('QUESTION_END'), 1200);
+	expect(clock.observe(signal('TRY', 8), 1300)).toBeNull();
+});
+
+test('excludes paused game time and resumes the same attempt', () => {
+	const clock = new DirectPressClock();
+	clock.observe(signal('TRY', 3), 100);
+	clock.observe(signal('PAUSE\n+'), 200);
+	expect(clock.capture(500)).toBeNull();
+	clock.observe(signal('PAUSE\n-'), 1200);
+	expect(clock.capture(1400)).toEqual({ DirectAttemptId: 3, DirectReactionMs: 300 });
+});
+
+test('ignores chat, other senders and openings without an attempt identifier', () => {
+	const clock = new DirectPressClock();
+	clock.observe({ ...signal('TRY', 2), IsSystem: false }, 0);
+	clock.observe({ ...signal('TRY', 2), Sender: 'other-player' }, 0);
+	clock.observe(signal('TRY'), 0);
+	expect(clock.capture(10)).toBeNull();
+});
+
+test('reset on disconnect prevents a stale attempt being sent after reconnect', () => {
+	const clock = new DirectPressClock();
+	clock.observe(signal('TRY', 8), 100);
+	clock.reset();
+	expect(clock.capture(200)).toBeNull();
+});
+
+test('room snapshots remove disconnected players and do not preserve values for a new connection', () => {
+	let state = roomReducer(undefined, setDirectMetrics([{ Name: 'Player', PingMs: 42, ReactionMs: 257 }]));
+	expect(state.directMetrics?.Player.ReactionMs).toBe(257);
+	state = roomReducer(state, setDirectMetrics([]));
+	expect(state.directMetrics?.Player).toBeUndefined();
+	state = roomReducer(state, setDirectMetrics([{ Name: 'Player', PingMs: null, ReactionMs: null }]));
+	expect(state.directMetrics?.Player.PingMs).toBeNull();
+	expect(state.directMetrics?.Player.ReactionMs).toBeNull();
+});
