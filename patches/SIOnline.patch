new file mode 100644
index 0000000000000000000000000000000000000000..1680cd9145bfbe4c479fd7a2b842dba4ea4ee1ee
--- /dev/null
+++ b/src/components/game/ParticipantMetrics/ParticipantMetrics.tsx
@@ -0,0 +1,29 @@
+import * as React from 'react';
+import { useAppSelector } from '../../../state/hooks';
+import { getDirectSession } from '../../../utils/DirectConnection';
+import './ParticipantMetrics.scss';
+
+interface ParticipantMetricsProps {
+	name: string;
+	showReaction?: boolean;
+	metric?: 'ping' | 'reaction';
+}
+
+export default function ParticipantMetrics({ name, showReaction = true, metric }: ParticipantMetricsProps): JSX.Element | null {
+	const values = useAppSelector(state => state.room2.directMetrics?.[name]);
+	const human = useAppSelector(state => state.room2.persons.all[name]?.isHuman);
+	const pingVisible = useAppSelector(state => state.settings.showDirectPing !== false) && metric !== 'reaction';
+	const reactionVisible = useAppSelector(state => state.settings.showDirectReaction !== false) && metric !== 'ping' && showReaction;
+	if (!getDirectSession() || !name || !human) { return null; }
+	if (!pingVisible && !reactionVisible) { return null; }
+	const format = (value: number | null | undefined, signed = false) => (
+		typeof value === 'number' && Number.isFinite(value) ? `${signed && value >= 0 ? '+' : ''}${value}` : '—'
+	);
+	return <div className={metric ? `participantMetrics participantMetrics--${metric}` : 'participantMetrics'} data-person={name}>
+		{pingVisible && <span title='Пинг: время до хоста и обратно. Обновляется каждые 2 секунды.'><b>{format(values?.PingMs)}</b></span>}
+		{reactionVisible && <span
+			title='Реакция: минус — до разрешения отвечать, плюс — после. Измеряется на устройстве игрока без сетевой задержки.'>
+			<b>{format(values?.ReactionMs, true)}</b>
+		</span>}
+	</div>;
+}
