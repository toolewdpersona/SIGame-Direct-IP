new file mode 100644
index 0000000000000000000000000000000000000000..0e4618101e380ee8c90b600f5cf22ffbf508b0c7
--- /dev/null
+++ b/src/utils/DirectPressClock.ts
@@ -0,0 +1,61 @@
+import Message from '../client/contracts/Message';
+
+/** Measures the first local press with a monotonic clock, independently of network travel time. */
+export default class DirectPressClock {
+	private startedAt: number | null = null;
+	private attemptId: number | null = null;
+	private pausedAt: number | null = null;
+	private questionActive = false;
+	private earlyPressedAt: number | null = null;
+	private hasPressed = false;
+
+	reset(): void {
+		this.startedAt = null;
+		this.attemptId = null;
+		this.pausedAt = null;
+		this.questionActive = false;
+		this.earlyPressedAt = null;
+		this.hasPressed = false;
+	}
+
+	observe(message: Message, now = performance.now()): { DirectAttemptId: number; DirectReactionMs: number } | null {
+		if (!message.IsSystem || message.Sender !== '@') { return null; }
+		const [command, arg] = message.Text.split('\n', 2);
+		if (command === 'TRY' && Number.isSafeInteger(message.DirectAttemptId)) {
+			this.startedAt = now;
+			this.attemptId = message.DirectAttemptId!;
+			this.pausedAt = null;
+			this.questionActive = true;
+			this.hasPressed = false;
+			if (this.earlyPressedAt !== null) {
+				const duration = Math.min(-1, Math.round(this.earlyPressedAt - now));
+				this.earlyPressedAt = null;
+				this.hasPressed = true;
+				return { DirectAttemptId: this.attemptId, DirectReactionMs: duration };
+			}
+		} else if (['ENDTRY', 'CHOICE', 'QUESTION', 'QUESTION_END', 'STAGE'].includes(command)) {
+			this.reset();
+			this.questionActive = command === 'CHOICE' || command === 'QUESTION';
+		} else if (command === 'PAUSE' && this.questionActive) {
+			if (arg === '+' && this.pausedAt === null) { this.pausedAt = now; }
+			if (arg === '-' && this.pausedAt !== null) {
+				if (this.startedAt !== null) { this.startedAt += now - this.pausedAt; }
+				if (this.earlyPressedAt !== null) { this.earlyPressedAt += now - this.pausedAt; }
+				this.pausedAt = null;
+			}
+		}
+		return null;
+	}
+
+	capture(now = performance.now()): { DirectAttemptId: number; DirectReactionMs: number } | { DirectEarlyPress: true } | null {
+		if (this.pausedAt !== null || this.hasPressed) { return null; }
+		if (this.startedAt === null || this.attemptId === null) {
+			if (!this.questionActive || this.earlyPressedAt !== null) { return null; }
+			this.earlyPressedAt = now;
+			return { DirectEarlyPress: true };
+		}
+		const result = { DirectAttemptId: this.attemptId, DirectReactionMs: Math.max(0, Math.round(now - this.startedAt)) };
+		this.hasPressed = true;
+		return result;
+	}
+}
