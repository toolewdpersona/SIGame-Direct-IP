<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SIGame.DirectHost</AssemblyName>
    <PublishTrimmed>true</PublishTrimmed>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
  <ItemGroup>
    <!-- Game models, SignalR methods and anonymous HTTP payloads use reflection.
         Retain these small assemblies in full; trim the much larger framework. -->
    <TrimmerRootAssembly Include="SIGame.DirectHost;SICore;SICore.Network;SICore.Connections;SIData;SI.Contracts;SIEngine;SIEngine.Core;SIPackages;SIUI.Model;Utils;Notions;ZipUtils;Ensure.That" />
    <EmbeddedResource Include="../mod-version.json" LogicalName="mod-version.json" />
    <ProjectReference Include="../SI/src/SICore/SICore/SICore.csproj" />
    <Content Include="../SIOnline/dist-web/**/*" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The player distribution does not attach a managed debugger or read Windows PDBs.
       Keep the SDK originals available with -p:IncludeHostDiagnostics=true for developers.
       Do not remove the JIT, GC, exception resources or other runtime libraries. -->
  <Target Name="ExcludeDeveloperDiagnostics" AfterTargets="ComputeFilesToPublish"
          Condition="'$(Configuration)' == 'Release' and '$(IncludeHostDiagnostics)' != 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Filename)' == 'mscordaccore' or
          $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('mscordaccore_')) or
          '%(ResolvedFileToPublish.Filename)' == 'mscordbi' or
          '%(ResolvedFileToPublish.Filename)' == 'Microsoft.DiaSymReader.Native.amd64'" />
    </ItemGroup>
  </Target>
</Project>
